    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "vite": "^8.3.4"
  }
}
