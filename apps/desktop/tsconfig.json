{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The bridge, the smoke page and the tests use @fxm/player and @fxm/platform, whose sources
    // use the web platform's types.
    "lib": ["es2023", "dom", "dom.iterable"],
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["bridge", "test", "smoke", "release"]
}
