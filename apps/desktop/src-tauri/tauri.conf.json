{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FXM",
  "identifier": "io.github.pratyayops.fxm",
  "build": {
    "beforeDevCommand": "pnpm --filter @fxm/web exec vite --base=/ --port 5260 --strictPort",
    "devUrl": "http://localhost:5260",
    "beforeBuildCommand": "pnpm --filter @fxm/web build:desktop",
    "frontendDist": "../../web/dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FXM",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0b0b0f",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src ipc: http://ipc.localhost 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'",
      "pattern": {
        "use": "isolation",
        "options": { "dir": "../isolation" }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "useLocalToolsDir": true,
    "icon": [
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Free, open-source music player",
    "longDescription": "FXM is a free, open-source music player: search and play practically any song.",
    "publisher": "FXM",
    "homepage": "https://github.com/Pratyay-ops/FXM",
    "license": "Apache-2.0",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "http": {
      "scopeRedirects": true
    }
  }
}
