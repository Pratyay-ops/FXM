{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FXM",
  "identifier": "io.github.pratyayops.fxm",
  "version": "../package.json",
  "build": {
    "beforeDevCommand": "pnpm --filter @fxm/web exec vite --base=/ --port 5260 --strictPort",
    "devUrl": "http://localhost:5260",
    "beforeBuildCommand": "pnpm --filter @fxm/web build:desktop",
    "frontendDist": "../../web/dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FXM",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0b0b0f",
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; media-src 'self' https: blob: fxm-media: http://fxm-media.localhost fxm-download: http://fxm-download.localhost; connect-src ipc: http://ipc.localhost 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'",
      "pattern": {
        "use": "isolation",
        "options": { "dir": "../isolation" }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "useLocalToolsDir": true,
    "icon": [
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Free, open-source music player",
    "longDescription": "FXM is a free, open-source music player: search and play practically any song.",
    "publisher": "FXM",
    "homepage": "https://github.com/Pratyay-ops/FXM",
    "license": "Apache-2.0",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "sound",
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav",
          "gstreamer1.0-pulseaudio | gstreamer1.0-alsa"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "http": {
      "scopeRedirects": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDREYwOTYyREQ1MkUxOTUKUldTVjRWTGRZZ25mSEZrQ2p1bXA1NzIwdDlhVWFXRUxPdHdta1hZcDRCa011c2dqZ2w4VkJhN24K",
      "endpoints": ["https://github.com/Pratyay-ops/FXM/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
