{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the FXM web app may do from the main window's own webview",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-user-hosts",
    "allow-approve-user-host",
    "allow-revoke-user-host",
    "allow-user-host-fetch",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://www.youtube.com/*" },
        { "url": "https://music.youtube.com/*" },
        { "url": "https://youtubei.googleapis.com/*" },
        { "url": "https://*.googlevideo.com/*" },
        { "url": "https://i.ytimg.com/*" },
        { "url": "https://*.ggpht.com/*" },
        { "url": "https://open.spotify.com/*" },
        { "url": "https://clienttoken.spotify.com/*" },
        { "url": "https://api-partner.spotify.com/*" },
        { "url": "https://spclient.wg.spotify.com/*" },
        { "url": "https://i.scdn.co/*" },
        { "url": "https://www.last.fm/player/station/*" },
        { "url": "https://ws.audioscrobbler.com/*" },
        { "url": "https://lrclib.net/*" },
        { "url": "https://musicbrainz.org/*" },
        { "url": "https://coverartarchive.org/*" },
        { "url": "https://api.listenbrainz.org/*" },
        { "url": "https://labs.api.listenbrainz.org/*" },
        { "url": "https://archive.org/*" },
        { "url": "https://*.archive.org/*" },
        { "url": "https://api.jamendo.com/*" },
        { "url": "https://*.jamendo.com/*" },
        { "url": "https://itunes.apple.com/*" },
        { "url": "https://sponsor.ajay.app/*" }
      ]
    }
  ]
}
