{
  "name": "@fxm/web",
  "version": "0.0.0",
  "private": true,
  "description": "FXM web player, installable web applet and embeddable mini-player",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "vite build --base=/ --outDir dist-mobile",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p e2e",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "FXM_SCREENSHOTS=1 playwright test screenshots"
  },
  "dependencies": {
    "@fxm/core": "workspace:*",
    "@fxm/player": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
