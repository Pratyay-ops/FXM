{
  "name": "@fxm/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "FXM Android app: the web app in a Capacitor shell",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "cap": "CI=1 NODE_OPTIONS=\"--experimental-strip-types --disable-warning=ExperimentalWarning $NODE_OPTIONS\" cap",
    "icons": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generate-icons.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
