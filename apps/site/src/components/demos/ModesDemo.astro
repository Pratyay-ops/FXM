---
import Icon from '../Icon.astro'

const songs = [
  { title: 'Paper Lanterns', artist: 'Quiet Harbor', art: 'art-1' },
  { title: 'Paper Lanterns (Acoustic)', artist: 'Quiet Harbor', art: 'art-3' },
]
const videos = [
  { title: 'Paper Lanterns, live at Union Hall', artist: 'Quiet Harbor', art: 'art-2' },
  { title: 'Paper Lanterns (piano cover)', artist: 'Mira Sol', art: 'art-4' },
  { title: 'Paper Lanterns (night drive remix)', artist: 'Kōda', art: 'art-5' },
]
---

<div
  class="demo"
  role="img"
  aria-label="Search results for a song. Two album songs appear in both modes. A live version, a piano cover and a remix are videos, so they appear only in Music + Video mode."
>
  <div class="query">
    <Icon name="search" size={16} />
    <span>paper lanterns</span>
  </div>
  <div class="group">
    <div class="group-head">
      <span>Songs</span>
      <span class="where">Music and Music + Video</span>
    </div>
    {songs.map((row) => (
      <div class="row">
        <span class:list={['art', row.art]} />
        <span class="meta">
          <span class="title">{row.title}</span>
          <span class="artist">{row.artist}</span>
        </span>
        <span class="kind song">Song</span>
      </div>
    ))}
  </div>
  <div class="group">
    <div class="group-head">
      <span>Videos</span>
      <span class="where">Music + Video only</span>
    </div>
    {videos.map((row) => (
      <div class="row">
        <span class:list={['art', 'wide', row.art]} />
        <span class="meta">
          <span class="title">{row.title}</span>
          <span class="artist">{row.artist}</span>
        </span>
        <span class="kind">Video</span>
      </div>
    ))}
  </div>
</div>

<style>
.query {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-full);
  background: var(--color-elevated);
  font-weight: 600;
}

.query svg {
  color: var(--color-text-muted);
}

.group {
  display: grid;
  gap: var(--space-1);
}

.group-head {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: var(--space-1) var(--space-3);
  padding: 0 var(--space-1) var(--space-1);
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.where {
  color: var(--color-accent);
  letter-spacing: 0.02em;
  text-transform: none;
}

.row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2);
  border-radius: var(--radius-lg);
}

.row:nth-child(even) {
  background: var(--color-elevated);
}

.art {
  flex: none;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: var(--radius-md);
}

.art.wide {
  width: 3.75rem;
}

.meta {
  display: grid;
  flex: 1;
  min-width: 0;
  line-height: 1.35;
}

.title {
  font-weight: 650;
}

.artist {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.artist {
  color: var(--color-text-muted);
  font-size: var(--text-xs);
}

.kind {
  flex: none;
  padding: var(--space-0-5) var(--space-2);
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius-full);
  color: var(--color-text-muted);
  font-size: var(--text-2xs);
  font-weight: 700;
}

.kind.song {
  border-color: var(--color-accent-line);
  background: var(--color-accent-soft);
  color: var(--color-text);
}
</style>
