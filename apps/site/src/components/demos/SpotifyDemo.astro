---
import Icon from '../Icon.astro'

const features = ["Search Spotify's catalog", 'Related artists', 'Song radio']
---

<div
  class="demo"
  role="img"
  aria-label="FXM settings with the Spotify integration switched on: Spotify search, related artists and song radio are enabled, and a button connects a Spotify account to sync recommendations, liked songs and playlists."
>
  <div class="label">Settings</div>
  <div class="setting">
    <span class="meta">
      <span class="title">Spotify integration</span>
      <span class="desc">Use Spotify's catalog in FXM</span>
    </span>
    <span class="switch"><span class="knob"></span></span>
  </div>
  <div class="checks">
    {features.map((feature) => (
      <span class="check">
        <Icon name="check" size={16} />
        {feature}
      </span>
    ))}
  </div>
  <div class="setting account">
    <span class="meta">
      <span class="title">Spotify account</span>
      <span class="desc">Sync recommendations, liked songs and playlists</span>
    </span>
    <span class="connect">Connect</span>
  </div>
  <div class="setting off">
    <span class="meta">
      <span class="title">Prefer not to?</span>
      <span class="desc">Switch it off and FXM doesn't contact Spotify.</span>
    </span>
    <span class="switch is-off"><span class="knob"></span></span>
  </div>
</div>

<style>
.label {
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-lg);
  background: var(--color-elevated);
}

.meta {
  display: grid;
  min-width: 0;
  line-height: 1.4;
}

.title {
  font-weight: 650;
}

.desc {
  color: var(--color-text-muted);
  font-size: var(--text-xs);
}

.switch {
  position: relative;
  flex: none;
  width: 2.75rem;
  height: 1.6rem;
  border-radius: var(--radius-full);
  background: var(--color-accent);
}

.knob {
  position: absolute;
  top: 0.2rem;
  right: 0.2rem;
  width: 1.2rem;
  height: 1.2rem;
  border-radius: var(--radius-full);
  background: var(--color-on-accent);
}

.switch.is-off {
  border: 1px solid var(--color-border-strong);
  background: transparent;
}

.switch.is-off .knob {
  top: calc(0.2rem - 1px);
  right: auto;
  left: calc(0.2rem - 1px);
  background: var(--color-text-muted);
}

.checks {
  display: grid;
  gap: var(--space-2);
  padding: 0 var(--space-4);
}

.check {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.check svg {
  color: var(--color-accent);
}

.connect {
  flex: none;
  padding: var(--space-1) var(--space-4);
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 700;
}

.off {
  border: 1px dashed var(--color-border-strong);
  background: transparent;
}
</style>
