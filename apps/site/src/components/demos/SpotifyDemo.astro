---
import { AVAILABLE } from '../../config'
import Icon from '../Icon.astro'

// Made-up artists, like every name in the illustrations.
const related = [
  { name: 'Mira Sol', art: 'art-4' },
  { name: 'Kōda', art: 'art-3' },
  { name: 'Nova Reyes', art: 'art-5' },
]
// The account sync is experimental (SPOTIFY_ACCOUNT_NOTE in src/lib/tiers.ts).
const account = AVAILABLE.spotifyAccount
const label = [
  "Illustration of FXM's Spotify settings. The Spotify integration is on, which is the default, and shows related artists from Spotify's catalog.",
  account
    ? 'A button connects a Spotify account for an experimental, read-only sync of recommendations, liked songs and playlists.'
    : 'Connecting a Spotify account for a read-only sync of recommendations, liked songs and playlists is coming soon.',
  // With the switch off, the app shows no Spotify-hosted image either (privacy page, Spotify).
  "A note says that when the integration is off, FXM doesn't contact Spotify at all.",
].join(' ')
const accountText = account
  ? 'Experimental: a read-only sync of recommendations, liked songs and playlists'
  : 'Read-only sync of recommendations, liked songs and playlists'
---

<div class="demo" role="img" aria-label={label}>
  <div class="label">Settings</div>
  <div class="setting">
    <span class="meta">
      <span class="title">Spotify integration</span>
      <span class="desc">On by default wherever FXM can reach Spotify</span>
    </span>
    <span class="switch"><span class="knob"></span></span>
  </div>
  <div class="related">
    <div class="label">Related artists, from Spotify</div>
    <div class="artists">
      {related.map((artist) => (
        <span class="artist">
          <span class:list={['avatar', artist.art]}></span>
          <span class="name">{artist.name}</span>
        </span>
      ))}
    </div>
  </div>
  <div class="setting account">
    <span class="meta">
      <span class="title">Spotify account</span>
      <span class="desc">{accountText}</span>
    </span>
    {account ? <span class="pill">Connect</span> : <span class="pill soon">Coming soon</span>}
  </div>
  <div class="note">
    <Icon name="plug" size={16} />
    Switch it off and FXM doesn't contact Spotify at all.
  </div>
</div>

<style>
.label {
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3) var(--space-4);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-lg);
  background: var(--color-elevated);
}

.meta {
  display: grid;
  min-width: 0;
  line-height: 1.4;
}

/* On narrow cards the account button moves under the text instead of squeezing it. */
.account {
  flex-wrap: wrap;
}

.account .meta {
  flex: 1 1 10rem;
}

.title {
  font-weight: 650;
}

.desc {
  color: var(--color-text-muted);
  font-size: var(--text-xs);
}

.switch {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: flex-end;
  width: 2.75rem;
  height: 1.6rem;
  padding: var(--space-1);
  border-radius: var(--radius-full);
  background: var(--color-accent);
}

.knob {
  width: 1.1rem;
  height: 1.1rem;
  border-radius: var(--radius-full);
  background: var(--color-on-accent);
}

.related {
  display: grid;
  gap: var(--space-3);
  padding-top: var(--space-1);
}

.artists {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-3);
}

.artist {
  display: grid;
  gap: var(--space-2);
  justify-items: center;
  min-width: 0;
  font-size: var(--text-xs);
  font-weight: 600;
}

.name {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avatar {
  width: 3rem;
  height: 3rem;
  border-radius: var(--radius-full);
}

.pill {
  flex: none;
  padding: var(--space-1) var(--space-4);
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 700;
}

.pill.soon {
  border-style: dashed;
  color: var(--color-text-muted);
}

.note {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4);
  border: 1px dashed var(--color-border-strong);
  border-radius: var(--radius-lg);
  color: var(--color-text-muted);
  font-size: var(--text-xs);
}

.note svg {
  color: var(--color-accent);
}
</style>
