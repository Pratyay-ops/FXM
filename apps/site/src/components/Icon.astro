---
import { type IconName, icons } from '../lib/icons'

/** A decorative inline icon (hidden from screen readers): the text next to it says what it means. */
interface Props {
  name: IconName
  size?: number
  class?: string
  /** The parent's data-astro-cid-* scope attribute, so its scoped styles reach the icon. */
  [attribute: `data-${string}`]: unknown
}

const { name, size = 24, class: className, ...rest } = Astro.props
const icon: { paths: readonly string[]; filled?: boolean } = icons[name]
const filled = icon.filled === true
---

<svg
  {...rest}
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {icon.paths.map((d) => <path d={d}></path>)}
</svg>
