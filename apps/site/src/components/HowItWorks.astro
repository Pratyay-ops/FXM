---
import { AVAILABLE } from '../config'
import { diagramLabel, howItWorksStep } from '../lib/tiers'
import Icon from './Icon.astro'
import Logo from './Logo.astro'

const saved = AVAILABLE.downloads
  ? 'Your library, history, settings and downloads are saved in your browser or in the app.'
  : 'Your library, history and settings are saved in your browser or in the app.'

const services = [
  'YouTube Music',
  'Spotify (optional)',
  'Last.fm',
  'ListenBrainz',
  'LRCLIB',
  'MusicBrainz',
  'Internet Archive',
  AVAILABLE.jamendo ? 'Jamendo' : 'Jamendo (coming soon)',
]
---

<section id="how-it-works" class="section how" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head center">
      <p class="eyebrow">How it works</p>
      <h2 id="how-title">
        No FXM servers. <span class="line">Everything runs on your device.</span>
      </h2>
      <p class="lead">
        FXM is an app, not an online service. There's no FXM account and no FXM server in the
        middle. Here is what happens when you press play.
      </p>
    </div>

    <div class="layout">
      <ol class="steps bare-list">
        <li>
          <span class="num">1</span>
          <div>
            <h3>You open FXM</h3>
            <p>
              On the web, your browser loads the app like any other page, then runs it. On desktop
              and Android, it's an app you install.
            </p>
          </div>
        </li>
        <li>
          <span class="num">2</span>
          <div>
            <h3>Your device asks the music services</h3>
            <p>{howItWorksStep(AVAILABLE.lite, AVAILABLE.jamendo)}</p>
          </div>
        </li>
        <li>
          <span class="num">3</span>
          <div>
            <h3>Your music stays with you</h3>
            <p>{saved} There's nothing to sign up for and nothing for FXM to collect.</p>
          </div>
        </li>
      </ol>

      <div
        class="diagram"
        role="img"
        aria-label={`Diagram: FXM runs on your device and talks directly to music services: YouTube Music, Spotify unless you switch it off, Last.fm, ListenBrainz, LRCLIB, MusicBrainz, Internet Archive and ${AVAILABLE.jamendo ? 'Jamendo' : 'Jamendo (coming soon)'}. Your library and history stay on your device. There are no FXM servers in between.`}
      >
        <div class="box device">
          <div class="box-label">
            <Icon name="monitor" size={16} />
            Your device
          </div>
          <div class="app">
            <Logo id="diagram" size={36} />
            <span class="app-text">
              <span class="app-name">FXM</span>
              <span class="app-where">{diagramLabel(AVAILABLE.lite)}</span>
            </span>
          </div>
          <div class="local">
            <Icon name="heart" size={16} />
            Your library and history stay here
          </div>
        </div>

        <div class="link">
          <span>Direct requests</span>
        </div>

        <div class="box services">
          <div class="box-label">
            <Icon name="music" size={16} />
            Music services
          </div>
          <div class="chips">
            {services.map((service) => <span class="chip">{service}</span>)}
          </div>
        </div>

        <div class="none">
          <Icon name="server-off" size={18} />
          <span><strong>FXM servers:</strong> none</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.how {
  border-block: 1px solid var(--color-border);
  background: var(--color-surface);
}

.line {
  display: block;
}

.layout {
  display: grid;
  gap: var(--space-12);
  align-items: center;
}

.steps {
  display: grid;
  gap: var(--space-8);
}

.steps li {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: var(--space-4);
}

.num {
  display: grid;
  place-items: center;
  width: 2.25rem;
  height: 2.25rem;
  border: 1px solid var(--color-accent-line);
  border-radius: var(--radius-full);
  background: var(--color-accent-soft);
  color: var(--color-accent);
  font-weight: 750;
}

.steps h3 {
  margin: var(--space-1) 0 var(--space-2);
}

.steps p {
  color: var(--color-text-muted);
}

.diagram {
  display: grid;
  justify-items: center;
  padding: var(--space-6);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-2xl);
  background: var(--color-background);
  font-size: var(--text-sm);
}

.box {
  display: grid;
  gap: var(--space-3);
  width: 100%;
  padding: var(--space-4);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  background: var(--color-surface);
}

.device {
  border-color: var(--color-accent-line);
  box-shadow: 0 0 0 4px var(--color-accent-soft);
}

.box-label {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.app {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.app-text {
  display: grid;
  line-height: 1.35;
}

.app-name {
  font-size: var(--text-lg);
  font-weight: 800;
}

.app-where {
  color: var(--color-text-muted);
  font-size: var(--text-xs);
}

.local {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
  background: var(--color-elevated);
  font-size: var(--text-xs);
  font-weight: 600;
}

.local svg {
  color: var(--color-accent);
}

.link {
  position: relative;
  display: grid;
  place-items: center;
  width: 100%;
  height: 4.5rem;
}

.link::before {
  content: "";
  position: absolute;
  top: 0;
  bottom: var(--space-2);
  left: 50%;
  border-left: 2px dashed var(--color-accent);
}

.link::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  border-top: 0.55rem solid var(--color-accent);
  border-right: 0.45rem solid transparent;
  border-left: 0.45rem solid transparent;
  transform: translateX(-50%);
}

.link span {
  position: relative;
  padding: var(--space-1) var(--space-3);
  border: 1px solid var(--color-accent-line);
  border-radius: var(--radius-full);
  background: var(--color-background);
  color: var(--color-text);
  font-size: var(--text-xs);
  font-weight: 650;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.chip {
  padding: var(--space-1) var(--space-3);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  background: var(--color-elevated);
  font-size: var(--text-xs);
  font-weight: 600;
}

.none {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-5);
  padding: var(--space-2) var(--space-4);
  border: 1px dashed var(--color-border-strong);
  border-radius: var(--radius-full);
  color: var(--color-text-muted);
}

.none strong {
  color: var(--color-text);
}

@media (min-width: 48rem) {
  .layout {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--space-8), 5vw, var(--space-16));
  }
}

@media (min-width: 64rem) {
  .diagram {
    padding: var(--space-8);
  }
}
</style>
