---
/**
 * The FXM mark: a violet tile with four sound bars. public/favicon.svg is the same
 * drawing with the colours written out. It is decorative: every use sits next to the
 * name FXM or inside a labelled link. `id` keeps the gradient id unique when the mark
 * appears more than once on a page.
 */
interface Props {
  id: string
  size?: number
}

const { id, size = 32 } = Astro.props
const gradient = `fxm-mark-${id}`
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={gradient} x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
      <stop class="from" offset="0"></stop>
      <stop class="via" offset="0.55"></stop>
      <stop class="to" offset="1"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="9" fill={`url(#${gradient})`}></rect>
  <g class="bars">
    <rect x="6.5" y="11" width="3.5" height="10" rx="1.75"></rect>
    <rect x="11.5" y="6.5" width="3.5" height="19" rx="1.75"></rect>
    <rect x="16.5" y="9.5" width="3.5" height="13" rx="1.75"></rect>
    <rect x="21.5" y="12.5" width="3.5" height="7" rx="1.75"></rect>
  </g>
</svg>

<style>
.from {
  stop-color: var(--mark-from);
}

.via {
  stop-color: var(--mark-via);
}

.to {
  stop-color: var(--mark-to);
}

.bars {
  fill: var(--mark-bars);
}
</style>
