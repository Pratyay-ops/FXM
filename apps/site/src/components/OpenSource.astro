---
import { APP_PATH, REPO_URL } from '../config'
import Icon from './Icon.astro'
import Logo from './Logo.astro'
---

<section class="section open" aria-labelledby="open-title">
  <div class="container">
    <div class="panel">
      <Logo id="open" size={56} />
      <h2 id="open-title">Built in the open</h2>
      <p class="lead">
        FXM is free software under the Apache-2.0 license. Follow along, report a problem or help
        build it on GitHub.
      </p>
      <div class="button-row">
        <a class="button button-primary button-large" href={REPO_URL}>
          <Icon name="code" />
          FXM on GitHub
        </a>
        <a class="button button-secondary button-large" href={APP_PATH}>Open web app</a>
      </div>
    </div>
  </div>
</section>

<style>
.open {
  padding-top: 0;
}

.panel {
  position: relative;
  isolation: isolate;
  display: grid;
  gap: var(--space-5);
  justify-items: center;
  overflow: hidden;
  padding: clamp(var(--space-10), 6vw, var(--space-20)) clamp(var(--space-5), 5vw, var(--space-16));
  border: 1px solid var(--color-accent-line);
  border-radius: var(--radius-2xl);
  background: var(--color-surface);
  text-align: center;
}

.panel::before {
  content: "";
  position: absolute;
  z-index: -1;
  inset: 0;
  background: radial-gradient(70% 90% at 50% 0%, var(--color-glow), transparent 70%);
}

.lead {
  max-width: 34rem;
}

.button-row {
  justify-content: center;
  margin-top: var(--space-2);
}

@media (max-width: 30rem) {
  .button-row {
    display: grid;
    width: 100%;
  }
}
</style>
