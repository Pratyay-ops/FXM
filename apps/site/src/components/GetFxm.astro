---
import { APP_PATH, AVAILABLE, DESKTOP_INSTALL_URL, RELEASES_URL } from '../config'
import { ANDROID_INSTALL, installFinePrint, noExtensionNote } from '../lib/connect'
import { webCardIntro } from '../lib/tiers'
import ComingSoon from './ComingSoon.astro'
import Icon from './Icon.astro'

// The Firefox steps appear once the signed add-on is out (AVAILABLE.firefox).
const finePrint = installFinePrint(AVAILABLE.firefox)
const firefoxUpdate = AVAILABLE.firefox ? 'In Firefox, install the new file the same way.' : ''
const noExtension = noExtensionNote(AVAILABLE.firefox, {
  lite: AVAILABLE.lite,
  jamendo: AVAILABLE.jamendo,
})
---

<section id="get" class="section" aria-labelledby="get-title">
  <div class="container">
    <div class="section-head center">
      <p class="eyebrow">Get FXM</p>
      <h2 id="get-title">Pick where you listen</h2>
      <p class="lead">
        FXM is in early development. Releases are published on GitHub as each app becomes ready.
      </p>
    </div>

    <div class="cards">
      <div class="card get-card web" id="get-web">
        <div class="card-head">
          <h3>Web app + FXM Connect</h3>
          <div class="badges">
            <span class="badge for-you" hidden>For this device</span>
            <span class="badge">Early preview</span>
          </div>
          <span class="icon-tile"><Icon name="browser" /></span>
        </div>
        <p>{webCardIntro(AVAILABLE.lite)}</p>
        {AVAILABLE.firefox && <h4 class="install-title">Chrome, Edge and Brave</h4>}
        <ol class="install">
          <li>
            Download the Chromium zip (<code>fxm-connect-chromium-….zip</code>) from the latest
            GitHub release and unzip it into a folder you'll keep.
          </li>
          <li>
            Type <code>chrome://extensions</code> in the address bar (<code>edge://extensions</code>
            in Edge, <code>brave://extensions</code> in Brave) and turn on
            <strong>Developer mode</strong>. Leave it on: when it's off, the browser turns FXM
            Connect off too.
          </li>
          <li>Choose <strong>Load unpacked</strong>, pick that folder, then reload the web app.</li>
        </ol>
        {AVAILABLE.firefox && (
          <>
            <h4 class="install-title">Firefox</h4>
            <ol class="install">
              <li>
                Download the Firefox add-on (<code>fxm-connect-firefox-….xpi</code>) from the latest
                GitHub release.
              </li>
              <li>
                In Firefox, open <code>about:addons</code>, click the gear button and choose
                <strong>Install Add-on From File</strong>.
              </li>
              <li>
                Pick the file, choose <strong>Add</strong>, then reload the web app.
              </li>
            </ol>
          </>
        )}
        <p class="fine">{finePrint}</p>
        {AVAILABLE.firefox && (
          <p class="fine">
            {ANDROID_INSTALL.map((part) =>
              typeof part === 'string' ? part : <strong>{part.label}</strong>,
            )}
          </p>
        )}
        <p class="fine">
          FXM Connect doesn't update itself. When the web app says FXM Connect is out of date, unzip
          the new release over the same folder and press <strong>Reload</strong> on the extension's
          card.
          {firefoxUpdate}
        </p>
        <div class="actions">
          <a class="button button-primary" href={APP_PATH}>
            Open web app
            <Icon name="arrow-right" />
          </a>
          <a class="button button-secondary" href={RELEASES_URL}>Get FXM Connect on GitHub</a>
        </div>
        <p class="no-extension">
          <Icon name="library" size={20} />
          <span>{noExtension}</span>
        </p>
      </div>

      <div class="card get-card" id="get-desktop">
        <div class="card-head">
          <h3>Desktop app</h3>
          <div class="badges">
            {AVAILABLE.desktop ? (
              <span class="badge for-you" hidden>
                For this device
              </span>
            ) : (
              <ComingSoon />
            )}
          </div>
          <span class="icon-tile"><Icon name="monitor" /></span>
        </div>
        <p>For macOS, Windows and Linux, with everything built in: no extension needed.</p>
        <ul class="platforms bare-list">
          <li>macOS</li>
          <li>Windows</li>
          <li>Linux</li>
        </ul>
        {AVAILABLE.desktop && (
          <p class="fine">
            FXM isn't signed by Apple or Microsoft, so macOS and Windows warn the first time you
            open it: the <a href={DESKTOP_INSTALL_URL}>install steps</a> say which file to pick and
            what to do. The app updates itself after asking you.
          </p>
        )}
        <div class="actions">
          <a class="button button-secondary" href={RELEASES_URL}>
            {AVAILABLE.desktop ? 'Download for desktop' : 'Follow releases on GitHub'}
          </a>
        </div>
      </div>

      <div class="card get-card" id="get-android">
        <div class="card-head">
          <h3>Android app</h3>
          <div class="badges">
            {AVAILABLE.android ? (
              <span class="badge for-you" hidden>
                For this device
              </span>
            ) : (
              <ComingSoon />
            )}
          </div>
          <span class="icon-tile"><Icon name="phone" /></span>
        </div>
        <p>
          An APK you install from GitHub Releases, with everything built in: no extension needed.
        </p>
        <ul class="platforms bare-list">
          <li>Android APK</li>
        </ul>
        <div class="actions">
          <a class="button button-secondary" href={RELEASES_URL}>
            {AVAILABLE.android ? 'Download the APK' : 'Follow releases on GitHub'}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
import { AVAILABLE } from '../config'
import { cardForPlatform, detectPlatform } from '../lib/platform'

// Suggest the card for this device when it has something to download today, and point
// the Download buttons at it. Otherwise they keep showing all three cards.
const nav = navigator as Navigator & { userAgentData?: { platform?: string } }
const card = cardForPlatform(
  detectPlatform({
    userAgent: nav.userAgent,
    platformHint: nav.userAgentData?.platform,
    maxTouchPoints: nav.maxTouchPoints,
  }),
  AVAILABLE,
)
const target = card && document.getElementById(`get-${card}`)
if (target) {
  target.classList.add('is-suggested')
  target.querySelector('.for-you')?.removeAttribute('hidden')
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-download-link]')) {
    link.setAttribute('href', `#${target.id}`)
  }
}
</script>

<style>
.cards {
  display: grid;
  gap: var(--space-5);
}

.get-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding: var(--space-5);
  transition: border-color var(--duration-fast) var(--ease-standard);
}

.get-card.is-suggested {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 4px var(--color-accent-soft);
}

/* The heading comes first for screen readers; the icon and status badges sit above it. */
.card-head {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  grid-template-areas:
    "icon badges"
    "title title";
  align-items: start;
  gap: var(--space-6) var(--space-3);
}

.card-head .icon-tile {
  grid-area: icon;
}

.card-head h3 {
  grid-area: title;
}

.badges {
  display: flex;
  grid-area: badges;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: var(--space-2);
}

.badge[hidden] {
  display: none;
}

.for-you {
  border-color: var(--color-accent);
  background: var(--color-accent);
  color: var(--color-on-accent);
}

.get-card > p {
  color: var(--color-text-muted);
}

.install {
  display: grid;
  gap: var(--space-2);
  padding-left: var(--space-5);
  color: var(--color-text-muted);
  font-size: var(--text-sm);
}

.install li::marker {
  color: var(--color-accent);
  font-weight: 700;
}

.install strong {
  color: var(--color-text);
}

.install code {
  white-space: nowrap;
  overflow-wrap: normal;
}

.install-title {
  margin-bottom: calc(var(--space-2) * -1);
  font-size: var(--text-sm);
  font-weight: 700;
}

.get-card > .fine {
  font-size: var(--text-sm);
}

.get-card > .fine strong {
  color: var(--color-text);
}

.no-extension {
  display: flex;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  border: 1px dashed var(--color-border-strong);
  border-radius: var(--radius-lg);
  color: var(--color-text-muted);
  font-size: var(--text-sm);
}

.no-extension svg {
  color: var(--color-accent);
}

.platforms {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.platforms li {
  padding: var(--space-1) var(--space-3);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  background: var(--color-elevated);
  font-size: var(--text-sm);
  font-weight: 600;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-top: auto;
  padding-top: var(--space-2);
}

.actions .button {
  flex: 1 1 auto;
}

/* In the web card the buttons follow the steps, and the note takes the spare space. */
.web .actions {
  margin-top: 0;
}

.web .no-extension {
  margin-top: auto;
}

@media (max-width: 30rem) {
  .actions .button {
    padding-inline: var(--space-4);
    font-size: var(--text-sm);
  }
}

@media (min-width: 30rem) {
  .get-card {
    padding: var(--space-6);
  }
}

@media (min-width: 48rem) {
  .cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .web {
    grid-column: 1 / -1;
  }

  .web .actions .button {
    flex: 0 1 auto;
  }
}

@media (min-width: 64rem) {
  /* The web app on the left, the two apps that are coming stacked on the right */
  .cards {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
  }

  .web {
    grid-column: 1;
    grid-row: span 2;
  }
}
</style>
