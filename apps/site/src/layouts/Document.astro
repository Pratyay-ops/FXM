---
import Base from './Base.astro'

/** A long-form text page (privacy, disclaimer): a title block, then prose. */
interface Props {
  title: string
  description: string
  heading: string
  lead: string
  /** Date the content last changed, as YYYY-MM-DD. */
  updated: string
}

const { title, description, heading, lead, updated } = Astro.props
const updatedLabel = new Date(`${updated}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
})
---

<Base title={title} description={description}>
  <article class="document">
    <header class="head">
      <div class="container">
        <h1>{heading}</h1>
        <p class="lead">{lead}</p>
        <p class="updated">Last updated <time datetime={updated}>{updatedLabel}</time></p>
      </div>
    </header>
    <div class="container body">
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
.head {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding-block: clamp(var(--space-12), 8vw, var(--space-20)) var(--space-10);
  border-bottom: 1px solid var(--color-border);
}

.head::before {
  content: "";
  position: absolute;
  z-index: -1;
  inset: 0;
  background: radial-gradient(50% 80% at 85% 0%, var(--color-glow), transparent 70%);
}

.head .container {
  display: grid;
  gap: var(--space-4);
}

.head h1 {
  font-size: clamp(2.25rem, 1.7rem + 2.4vw, 3.25rem);
}

.head .lead {
  max-width: var(--container-prose);
}

.updated {
  color: var(--color-text-muted);
  font-size: var(--text-sm);
}

.body {
  padding-block: var(--space-6) var(--space-section);
}
</style>
