---
import { AVAILABLE, ISSUES_URL, REPO_URL } from '../config'
import Document from '../layouts/Document.astro'
import { privacyInstall, privacyUpdateCheck } from '../lib/connect'
import { privacyLiteCheck } from '../lib/tiers'

/** " (coming soon)" after anything AVAILABLE in src/config.ts doesn't mark as released. */
const soon = (released: boolean) => (released ? '' : ' (coming soon)')

interface Service {
  name: string
  /** The service's home page; left out when there is no single site to name. */
  url?: string
  use: string
}

const services: Service[] = [
  {
    name: 'YouTube',
    url: 'https://www.youtube.com',
    use: `YouTube Music and YouTube: search, song and video details, audio, and radio${soon(AVAILABLE.radio)}. ${privacyLiteCheck(AVAILABLE.lite)} Only while one of FXM's experimental ways of playing YouTube songs is switched on (they ship switched off), also Google's BotGuard service, to get the token YouTube asks for before it plays a song.`,
  },
  {
    name: 'Spotify',
    url: 'https://www.spotify.com',
    use: `When the Spotify integration is on (the default in the apps, and in the web app with FXM Connect; you can switch it off in Settings): search, related artists, recommendations for your home feed${soon(AVAILABLE.homeFeed)}, and song radio${soon(AVAILABLE.radio)}. If you connect your Spotify account${soon(AVAILABLE.spotifyAccount)}, also your recommendations, liked songs and playlists, and Spotify then knows these requests come from your account.`,
  },
  {
    name: 'Spotify key source',
    use: "When the Spotify integration is on: a community-maintained file with the current key of Spotify's web player, which FXM needs to get an anonymous Spotify token. The file is in a third-party repository on GitHub, which FXM doesn't run, and GitHub serves it from raw.githubusercontent.com, so GitHub's privacy policy applies to that request.",
  },
  { name: 'LRCLIB', url: 'https://lrclib.net', use: 'Synced lyrics.' },
  {
    name: 'MusicBrainz',
    url: 'https://musicbrainz.org',
    use: 'Song, album and artist information.',
  },
  {
    name: 'ListenBrainz',
    url: 'https://listenbrainz.org',
    use: `Recommendations for your home feed, and finding a song's album for its cover${soon(AVAILABLE.homeFeed)}. If you connect your ListenBrainz account in Settings (scrobbling, off until you do): each song you play (its title, artists and album, its track number and length, and its ISRC and Spotify link when known), with when you started it and how long you listened, and the song playing now. Each is marked as played with FXM and its version, and sent with the user token you entered. Your ListenBrainz profile and listens are public.`,
  },
  {
    name: 'Last.fm',
    url: 'https://www.last.fm',
    use: `In the apps and the web app with FXM Connect, Last.fm's stations, as recommendations for your home feed${soon(AVAILABLE.homeFeed)}. If you connect your Last.fm account in Settings (scrobbling, off until you do): each song you play (its title, main artist and album, its track number and length) with when you started it, and the song playing now. Songs that FXM's radio picked are marked as not chosen by you. They are sent with your API key and session key, and signed with your shared secret, which FXM never sends. Your Last.fm profile and the songs you scrobble are public by default.`,
  },
  {
    name: 'Cover Art Archive',
    url: 'https://coverartarchive.org',
    use: `Album covers for songs whose source has none${soon(AVAILABLE.homeFeed)}. Covers load from the Internet Archive's servers.`,
  },
  {
    name: "Apple's iTunes Search",
    url: 'https://performance-partners.apple.com/search-api',
    use: 'Album covers for songs that neither their source nor the Cover Art Archive has one for (coming soon).',
  },
  {
    name: 'Internet Archive',
    url: 'https://archive.org',
    use: 'Free music, including lossless FLAC.',
  },
  {
    name: 'Jamendo',
    url: 'https://www.jamendo.com',
    use: AVAILABLE.jamendo
      ? 'Free music, including lossless FLAC.'
      : "Free music, including lossless FLAC (coming soon). FXM contacts Jamendo only once it is turned on, and this version doesn't have it on.",
  },
  {
    name: 'SponsorBlock',
    url: 'https://sponsor.ajay.app',
    use: "Only if you turn it on (it's off by default), in Music + Video mode: which parts of a music video aren't music, such as an intro or a skit, so FXM can skip them. FXM sends only the first four characters of a hash of the video's ID, which a great many videos share, so SponsorBlock can't tell which video you play.",
  },
  {
    name: 'GitHub',
    url: 'https://github.com',
    use: "If you turn on sync in the app's settings: your library, your settings and the plays of the last 90 days, kept in a secret gist on your own GitHub account with a token you create. GitHub keeps every earlier version of the gist, so together they hold every play synced since you turned sync on, and what you removed since. GitHub doesn't list or search secret gists, but anyone who has the link can open one and its earlier versions. Whenever the Spotify integration is on, also the Spotify key file above, which GitHub hosts (raw.githubusercontent.com).",
  },
]

const cookies = `FXM doesn't set cookies or use them to follow you. If you connect your Spotify account${soon(AVAILABLE.spotifyAccount)}, FXM uses your Spotify login as described in`
const downloads = AVAILABLE.downloads
  ? 'So are your downloads.'
  : 'Downloads will be stored there too, once they arrive.'
const spotifyLogin = `Connecting your Spotify account is optional${AVAILABLE.spotifyAccount ? '' : ' and coming soon'}. If you do, FXM uses your Spotify login to get an access token from Spotify.`
const updates = `The desktop and Android apps${soon(AVAILABLE.desktop || AVAILABLE.android)} also check GitHub for updates. When they start, they fetch FXM's YouTube settings file from this website, and download FXM's signed YouTube code from it too, so YouTube keeps working between app releases. That code is checked against FXM's signature before it runs.`
const embeds = `Other websites can show an FXM player for a song, an album or a playlist${soon(AVAILABLE.embed)}. The player runs in your browser, like the web app. As soon as the page shows it, even before you press play, your browser loads what it shows from its source: the details and cover art, and for YouTube a check that it can reach YouTube Music. So that source, such as YouTube, receives your IP address and which song, album or playlist the player shows, even if you have never used FXM. FXM doesn't see it. The website that shows the player can start or pause it and learns what it plays, as with any embedded player.`
const connectInstall = privacyInstall(AVAILABLE.firefox)
const connectUpdates = privacyUpdateCheck(AVAILABLE.firefox)
const webAppUpdates =
  "The web app keeps a copy of its own files on your device, so it opens without a connection: never your music, or anything the music services send. While it is open, it checks this website about once an hour for a new version of itself, and when it first uses YouTube Music, it fetches FXM's signed YouTube settings file from this website too."
const plugins =
  'FXM comes with no plugins and suggests none. If you add one, from an address or a file you choose, FXM downloads it from that address and checks it against the checksum its author published. A plugin runs apart from FXM’s pages and your data, and contacts only the addresses it lists, which FXM shows you before you add it. Those services then receive your IP address and what you ask of the plugin, such as what you search for in its catalog, and their own privacy policies apply. FXM checks for an update of a plugin only when you ask, and installs it only when you approve it.'
---

<Document
  title="Privacy · FXM"
  description="FXM has no analytics, no accounts and no servers, and sets no cookies. Your data stays on your device unless you turn on sync. Here is which services your device talks to, and why."
  heading="Privacy"
  lead="FXM is built so that there is nothing to collect: no analytics, no accounts, no cookies set by FXM, and your data stays on your device unless you turn on sync."
  updated="2026-10-26"
>
  <h2>The short version</h2>
  <ul>
    <li>
      <strong>No analytics or tracking.</strong>
      This website and the FXM apps contain no analytics, trackers or ad scripts.
    </li>
    <li>
      <strong>No accounts.</strong>
      There is nothing to sign up for, so FXM never has your name, email address or password.
    </li>
    <li>
      <strong>No cookies set by FXM.</strong>
      {cookies}
      <a href="#spotify-login">Your Spotify login</a>.
    </li>
    <li>
      <strong>No FXM servers.</strong>
      Searches and plays don't pass through FXM, so FXM can't see what you look for or listen to.
    </li>
  </ul>

  <h2>Where your data lives</h2>
  <p>
    Your library (likes and playlists), listening history and settings are stored on your device: in
    your browser's storage for the web app, or in the app's own storage on desktop and Android.
    {downloads}
    FXM can't see any of it.
  </p>
  <p>
    The token and keys of a scrobbling account you connect are stored there too, and library backups
    leave them out.
  </p>
  <p>
    If you turn on sync, a copy also goes to a secret gist on your own GitHub account, so your other
    devices can read it. The token that lets FXM write it stays on your device. GitHub keeps every
    earlier version of the gist, and anyone with the gist's link can read them all. Removing
    something in FXM, or clearing your history, doesn't remove it from those versions: delete the
    gist to remove everything.
  </p>
  <p>
    Clearing this site's data in your browser, or uninstalling the app, deletes what is on your
    device for good. A sync gist stays on GitHub until you delete it there, or turn off sync in FXM
    and choose to delete it.
  </p>

  <h2>Services your device talks to</h2>
  <p>
    FXM gets music, information and lyrics straight from the services below. Your device connects to
    them directly; in the web app, FXM Connect adjusts some of these requests so the services
    answer. As with any website you visit, they receive your IP address and the requests made for
    you, such as a search or the song you're playing, and their own privacy policies apply.
  </p>
  <dl class="services">
    {services.map((service) => (
      <div>
        <dt>{service.url ? <a href={service.url}>{service.name}</a> : service.name}</dt>
        <dd>{service.use}</dd>
      </div>
    ))}
  </dl>

  <h2 id="spotify-login">Your Spotify login</h2>
  <p>{spotifyLogin} FXM never sees your password.</p>
  <ul>
    <li>
      In the browser, FXM Connect's <strong>Use my Spotify login from this browser</strong> option,
      which is off by default, lets your browser send your Spotify cookies with that one token
      request. FXM Connect never reads or stores them.
    </li>
    <li>
      In the desktop and Android apps, you sign in on Spotify's own login page, in a window of the
      app. Your login stays on your device, in protected storage.
    </li>
  </ul>
  <p>
    Spotify then knows that these requests come from your account. Disconnecting in Settings removes
    the token from FXM.
  </p>

  <h2 id="fxm-connect">FXM Connect</h2>
  <p>
    FXM Connect is the small browser extension that lets the web app reach YouTube, Spotify and
    Last.fm.
    {connectInstall}
    Here is what it does:
  </p>
  <ul>
    <li>
      It works only with FXM's own pages. Its rules apply only to requests those pages make to the
      services above, and it can't read or change what you do on other sites.
    </li>
    <li>
      It adjusts a few headers on those requests so the services answer, and removes your cookies
      from them.
    </li>
    <li>When the web app asks, it fetches Spotify's public server time, without your cookies.</li>
    <li>It runs only the code it was installed with and never downloads code from the internet.</li>
    <li>It sends nothing to FXM: no analytics and no telemetry.</li>
    <li>
      Its Spotify login option is off by default;
      <a href="#spotify-login">Your Spotify login</a>
      explains what it does when you turn it on.
    </li>
  </ul>
  <p>
    Its source code, with the full list of its permissions, is in the
    <a href={REPO_URL}>FXM repository on GitHub</a>.
  </p>

  <h2>This website and app downloads</h2>
  <p>
    This website and the web app are static files hosted on Cloudflare Pages, and FXM Connect and
    the apps are published on GitHub Releases. Like any host, Cloudflare and GitHub handle the
    network requests needed to deliver those files, under their own privacy policies. FXM doesn't
    add analytics or tracking to either.
    {connectUpdates}
  </p>
  <p>{webAppUpdates}</p>
  <p>{updates}</p>

  <h2 id="players-on-other-websites">FXM players on other websites</h2>
  <p>{embeds}</p>

  <h2 id="plugins">Plugins</h2>
  <p>{plugins}</p>

  <h2>Changes</h2>
  <p>
    If the way FXM handles data ever changes, this page will be updated and the date at the top will
    change.
  </p>

  <h2>Questions</h2>
  <p>Ask on the <a href={ISSUES_URL}>FXM issue tracker on GitHub</a>.</p>
</Document>

<style>
.services {
  display: grid;
  gap: var(--space-2);
  margin-top: var(--space-5);
}

.services div {
  display: grid;
  padding: var(--space-1) var(--space-5) var(--space-4);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
}

/* Each name is a 44 px row, so the links are easy to tap. */
.services dt {
  display: flex;
  align-items: center;
  min-height: var(--touch);
  font-weight: 700;
}

.services dt a {
  display: inline-flex;
  align-items: center;
  min-height: var(--touch);
}

.services dd {
  color: var(--color-text-muted);
}

@media (min-width: 40rem) {
  .services div {
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-1);
  }

  /* The name sits at the top, level with the first line of the description. */
  .services dt {
    align-self: start;
  }

  .services dd {
    padding-block: var(--space-2);
  }
}
</style>
