{
  "name": "fxm",
  "version": "0.2.0",
  "private": true,
  "description": "FXM (Free Cross-platform Media): free, open-source music player for web, PWA and Android",
  "license": "Apache-2.0",
  "repository": "github:Pratyay-ops/FXM",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "packageManager": "pnpm@12.12.1",
  "scripts": {
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit -p . && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
