{
  "name": "@fxm/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "FXM translations: keyed messages with ICU plurals and selects, locale negotiation, Intl formatting, a React provider and pseudo-locales",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./pseudo": "./src/pseudo.ts",
    "./check": "./src/check.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tools",
    "inventory": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/inventory.ts",
    "size": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/size.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rolldown": "1.2.13"
  }
}
