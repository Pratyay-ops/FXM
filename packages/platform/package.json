{
  "name": "@fxm/platform",
  "version": "0.2.1",
  "private": true,
  "description": "FXM platform adapters: network transports, FXM Connect detection, capability detection and the shared YouTube request budget",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./testing/evaluator": "./src/testing/evaluator.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/sandbox/tsconfig.node.json",
    "sandbox:build": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/sandbox/tools/build.ts",
    "build:evaluator": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-evaluator.ts",
    "test:e2e": "../../scripts/run.sh playwright install --no-shell chromium firefox && ../../scripts/run.sh playwright test -c src/sandbox/e2e/playwright.config.ts",
    "test:e2e:updates": "playwright test -c src/updates/e2e/playwright.config.mjs"
  },
  "dependencies": {
    "@fxm/core": "workspace:*",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "bgutils-js": "^4.0.3"
  },
  "devDependencies": {
    "@fxm/sources": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.3",
    "playwright-core": "^1.64.1",
    "rolldown": "^1.2.14",
    "vite": "^8.3.4"
  }
}
