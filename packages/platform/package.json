{
  "name": "@fxm/platform",
  "version": "0.0.0",
  "private": true,
  "description": "FXM platform adapters: network transports, FXM Connect detection, capability detection and the shared YouTube request budget",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/sandbox/tsconfig.node.json",
    "sandbox:build": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/sandbox/tools/build.ts",
    "test:e2e": "../../scripts/run.sh playwright install --no-shell chromium firefox && ../../scripts/run.sh playwright test -c src/sandbox/e2e/playwright.config.ts",
    "test:e2e:updates": "playwright test -c src/updates/e2e/playwright.config.mjs"
  },
  "dependencies": {
    "@fxm/core": "workspace:*",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-http": "^2.8.2"
  },
  "devDependencies": {
    "@fxm/sources": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.6",
    "rolldown": "^1.2.13",
    "vite": "^8.3.4"
  }
}
