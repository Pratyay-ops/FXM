{
  "name": "@fxm/deploy",
  "version": "0.2.0",
  "private": true,
  "description": "make dist and its checks: composes the site, the web app and the sandbox documents for Cloudflare Pages, with generated headers and third-party notices",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dist": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/main.ts",
    "preview": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/pages-server.ts",
    "check:headers": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/check-headers.ts",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5"
  }
}
